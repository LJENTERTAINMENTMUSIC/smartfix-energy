{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "admin-app": {
      "root": "admin-app",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "admin-app"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin-app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
